# Copiá este archivo como ".env" (sin .example) y pegá tus claves.
DEEPGRAM_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Traductor: claude (mejor para hebreo) o google
ANTHROPIC_API_KEY=
TRANSLATOR=google

# Opcionales
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=he
# PORT=8765

# Ajustes de corte de las traducciones
SILENCE_FLUSH=2
MIN_LINE_CHARS=30
HARD_LINE_CHARS=180